#, c-format
msgid "Coloring zone '%s' (%d LEDs): click keys on the picture or drag over an area to add or remove them."
msgstr "Colouring zone '%s' (%d LEDs): click keys on the picture or drag over an area to add or remove them."

msgid "Coloring the whole keyboard (base color; zones keep their colors). Select a zone in the list to color its keys."
msgstr "Colouring the whole keyboard (base colour; zones keep their colours). Select a zone in the list to colour its keys."

#, c-format
msgid "Profile '%s' created: pick a color for the whole keyboard or create zones"
msgstr "Profile '%s' created: pick a colour for the whole keyboard or create zones"

#, c-format
msgid "Zone '%s' created: click keys to add them, then choose its color"
msgstr "Zone '%s' created: click keys to add them, then choose its colour"

#, c-format
msgid "Delete zone '%s'? Its keys get the base color."
msgstr "Delete zone '%s'? Its keys get the base colour."

#, c-format
msgid "'%s' has the base color - select or create a zone to color single keys"
msgstr "'%s' has the base colour - select or create a zone to colour single keys"

msgid "Zone Color"
msgstr "Zone Colour"

msgid "Keyboard Color"
msgstr "Keyboard Colour"

msgid "Custom color"
msgstr "Custom colour"

msgid "Honoring <b>Linus Torvalds</b>, the visionary founder of Linux"
msgstr "Honouring <b>Linus Torvalds</b>, the visionary founder of Linux"

msgid "Lights one LED after the other; click the matching key on the picture below. Needed once for per-key colors."
msgstr "Lights one LED after the other; click the matching key on the picture below. Needed once for per-key colours."

msgid "Preset Colors"
msgstr "Preset Colours"

msgid "Choose any color"
msgstr "Choose any colour"

msgid "Animated effect of the selected zone, or of the base color when no zone is selected. Breathing fades the color in and out; Rainbow and Wave use all colors. Runs in the keyboard daemon, also when this window is closed."
msgstr "Animated effect of the selected zone, or of the base colour when no zone is selected. Breathing fades the colour in and out; Rainbow and Wave use all colours. Runs in the keyboard daemon, also when this window is closed."

msgid "Stop editing a zone: colors go to the whole keyboard (base color)"
msgstr "Stop editing a zone: colours go to the whole keyboard (base colour)"

msgid "Color"
msgstr "Colour"

msgid "Keyboard daemon, Keyboard Backlight tab, keyboard profiles in the tray menu. The LEDs keep their last colors."
msgstr "Keyboard daemon, Keyboard Backlight tab, keyboard profiles in the tray menu. The LEDs keep their last colours."

msgid "Behavior"
msgstr "Behaviour"
