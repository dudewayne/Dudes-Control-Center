[Unit]
Description=Dudes Control Center CPU Daemon
After=network.target
# Switched off in the GUI's Settings tab (dcc-component, 1.27.0)
ConditionPathExists=!/etc/dudes-control-center/disabled-cpu

[Service]
Type=simple
ExecStart=/usr/local/bin/dcc-cpu-daemon --foreground
Restart=always
User=root

[Install]
WantedBy=multi-user.target
