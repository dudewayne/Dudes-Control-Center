[Unit]
Description=Dudes Control Center Hard Limit Fail-Safe Timer
Documentation=man:systemd.timer(5)
# Switched off in the GUI's Settings tab (dcc-component, 1.27.0)
ConditionPathExists=!/etc/dudes-control-center/disabled-cpu

[Timer]
OnBootSec=10
OnUnitActiveSec=10
AccuracySec=1
Unit=dcc-hard-limit-enforcer.service

[Install]
WantedBy=timers.target
