[Unit]
Description=Dudes Control Center Keyboard Backlight Daemon
After=network.target
# Switched off in the GUI's Settings tab (dcc-component, 1.27.0)
ConditionPathExists=!/etc/dudes-control-center/disabled-keyboard

[Service]
Type=simple
ExecStart=/usr/local/bin/dcc-kbd-daemon
Restart=always
RestartSec=3
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
